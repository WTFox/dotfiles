#!/usr/bin/env bash

CONFIG_FILE_NAME="tmux-sessionizer.conf"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer"
CONFIG_FILE="$CONFIG_DIR/$CONFIG_FILE_NAME"

# config file example
# ------------------------
# # file: ~/.config/tmux-sessionizer/tmux-sessionizer.conf
# # If set this override the default TS_SEARCH_PATHS (~/ ~/personal ~/personal/dev/env/.config)
# TS_SEARCH_PATHS=(~/)
# # If set this add additional search paths to the default TS_SEARCH_PATHS
# # The number prefix is the depth for the Path [OPTIONAL]
# TS_EXTRA_SEARCH_PATHS=(~/ghq:3 ~/Git:3 ~/.config:2)
# # if set this override the TS_MAX_DEPTH (1)
# TS_MAX_DEPTH=2
# ------------------------

if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi

LOCAL_CONFIG_FILE="$CONFIG_DIR/${CONFIG_FILE_NAME%.conf}.local.conf"
if [[ -f "$LOCAL_CONFIG_FILE" ]]; then
    source "$LOCAL_CONFIG_FILE"
fi

user_selected=""
internal_action=""
internal_target=""
SELF="$0"

while [[ "$#" -gt 0 ]]; do
    case "$1" in
    -h | --help)
        echo "Usage: tmux-sessionizer [OPTIONS] [SEARCH_PATH]"
        echo "Options:"
        echo "  -h, --help             Display this help message"
        exit 0
        ;;
    --internal-list-entries)
        internal_action="list-entries"
        ;;
    --internal-kill)
        internal_action="kill"
        internal_target="$2"
        shift
        ;;
    --internal-kill-others)
        internal_action="kill-others"
        internal_target="$2"
        shift
        ;;
    --internal-rename)
        internal_action="rename"
        internal_target="$2"
        shift
        ;;
    *)
        user_selected="$1"
        ;;
    esac
    shift
done

sanity_check() {
    if ! command -v tmux &>/dev/null; then
        echo "tmux is not installed. Please install it first."
        exit 1
    fi

    if ! command -v fzf &>/dev/null; then
        echo "fzf is not installed. Please install it first."
        exit 1
    fi
}

switch_to() {
    if [[ -n "${TS_POPUP_RESULT:-}" ]]; then
        echo "$1" >"$TS_POPUP_RESULT"
        return
    fi

    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$1"
    else
        tmux switch-client -t "$1"
    fi
}

has_session() {
    tmux has-session -t "=$1" 2>/dev/null
}

session_name_for() {
    local name="${1##*/}"
    echo "${name//./_}"
}

# Resolve an fzf raw key (either "[TMUX] name" or a directory path) to a
# tmux session name.
target_session_name() {
    if [[ "$1" == "[TMUX] "* ]]; then
        echo "${1#\[TMUX\] }"
    else
        session_name_for "$1"
    fi
}

is_tmux_running() {
    if [[ -n $TMUX ]]; then
        return 0
    fi
    pgrep tmux >/dev/null && return 0
    return 1
}

sanity_check

# if TS_SEARCH_PATHS is not set use default
[[ -n "$TS_SEARCH_PATHS" ]] || TS_SEARCH_PATHS=(~/ ~/personal ~/personal/dev/env/.config)

# Add any extra search paths to the TS_SEARCH_PATHS array
# e.g : EXTRA_SEARCH_PATHS=("$HOME/extra1:4" "$HOME/extra2")
# note : Path can be suffixed with :number to limit or extend the depth of the search for the Path

if [[ ${#TS_EXTRA_SEARCH_PATHS[@]} -gt 0 ]]; then
    TS_SEARCH_PATHS+=("${TS_EXTRA_SEARCH_PATHS[@]}")
fi

# Nerd Font glyph + truecolor ANSI for session rows only.
ICON_SESSION=$''  # nf-oct-terminal
COLOR_SESSION=$'\033[1;38;2;194;145;106m'
COLOR_RESET=$'\033[0m'

# utility function to find directories
find_dirs() {
    local entry path depth
    for entry in "${TS_SEARCH_PATHS[@]}"; do
        depth=""
        # Check if entry as :number as suffix then adapt the maxdepth parameter
        if [[ "$entry" =~ ^([^:]+):([0-9]+)$ ]]; then
            path="${BASH_REMATCH[1]}"
            depth="${BASH_REMATCH[2]}"
        else
            path="$entry"
        fi

        [[ -d "$path" ]] || continue
        find "$path" -mindepth 1 -maxdepth "${depth:-${TS_MAX_DEPTH:-1}}" \( -name '.*' -o -name 'node_modules' \) -prune -o -type d -print | sed "s|^$HOME|~|" | sort -u
    done | awk '!seen[$0]++'
}

# List active tmux sessions (styled, current session pinned last) followed by
# directories. Emits "raw_key\tdisplay" so fzf's key binds can act on the raw
# key while --with-nth shows only the styled column.
list_entries() {
    local this_session=""
    [[ -n "${TMUX}" ]] && this_session=$(tmux display-message -p '#S' 2>/dev/null)
    tmux list-sessions -F '#{session_name}' 2>/dev/null | sort | awk -v cur="$this_session" '
        $0 == cur { cur_line = $0; next }
        { print }
        END { if (cur_line != "") print cur_line }
    ' | while IFS= read -r name; do
        printf '[TMUX] %s\t%s  %s%s%s\n' "$name" "$ICON_SESSION" "$COLOR_SESSION" "$name" "$COLOR_RESET"
    done

    find_dirs | awk -F'\t' '{print $0"\t"$0}'
}

# Dispatch for actions invoked by fzf key bindings (see the fzf --bind options
# below). These re-invoke this script with the highlighted directory so the
# logic lives in one place instead of inline in fzf's bind syntax.
if [[ -n "$internal_action" ]]; then
    case "$internal_action" in
    list-entries)
        list_entries
        ;;
    kill)
        target_session=$(target_session_name "$internal_target")
        tmux kill-session -t "$target_session" 2>/dev/null
        ;;
    kill-others)
        target_session=$(target_session_name "$internal_target")
        this_session=$(tmux display-message -p '#S' 2>/dev/null)
        tmux list-sessions -F '#{session_name}' 2>/dev/null | while read -r s; do
            [[ "$s" == "$this_session" || "$s" == "$target_session" ]] && continue
            tmux kill-session -t "$s" 2>/dev/null
        done
        ;;
    rename)
        target_session=$(target_session_name "$internal_target")
        if has_session "$target_session"; then
            read -r -p "Rename '$target_session' to: " new_name
            [[ -n "$new_name" ]] && tmux rename-session -t "$target_session" "$new_name"
        fi
        ;;
    esac
    exit 0
fi

# Re-launch the interactive picker inside a tmux popup when run from within
# tmux. A direct-path invocation skips this (it's meant to run instantly, not
# through a picker UI).
if [[ -z $user_selected && -n ${TMUX:-} && -z ${TS_POPUP:-} ]]; then
    ts_popup_result=$(mktemp)
    tmux display-popup -E -w 85% -h 80% -- env TS_POPUP=1 TS_POPUP_RESULT="$ts_popup_result" "$0" "$@"
    if [[ -s "$ts_popup_result" ]]; then
        switch_to "$(<"$ts_popup_result")"
    fi
    rm -f "$ts_popup_result"
    exit 0
fi

if [[ ! -z $user_selected ]]; then
    selected="$user_selected"
else
    selected=$(list_entries | fzf \
        --ansi \
        --delimiter '\t' \
        --with-nth 2.. \
        --info=inline \
        --prompt '  ' \
        --pointer '▸' \
        --header '↵ open  ctrl-x kill  ctrl-r rename  ctrl-alt-x kill others' \
        --bind "ctrl-x:execute-silent(\"$SELF\" --internal-kill {1})+reload(\"$SELF\" --internal-list-entries)" \
        --bind "ctrl-r:execute(\"$SELF\" --internal-rename {1})+reload(\"$SELF\" --internal-list-entries)" \
        --bind "ctrl-alt-x:execute-silent(\"$SELF\" --internal-kill-others {1})+reload(\"$SELF\" --internal-list-entries)" \
        || true)
    selected="${selected%%$'\t'*}"
fi

if [[ -z $selected ]]; then
    exit 0
fi

if [[ "$selected" == "[TMUX] "* ]]; then
    switch_to "${selected#\[TMUX\] }"
    exit 0
fi

selected="${selected/#\~/$HOME}"
selected_name=$(session_name_for "$selected")

if ! is_tmux_running; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if ! has_session "$selected_name"; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

switch_to "$selected_name"
