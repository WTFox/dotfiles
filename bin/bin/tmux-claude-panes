#!/usr/bin/env bash
#
# Interactive fzf browser for all running Claude Code panes across every
# tmux session/window. Shows each pane's directory, topic (from its title),
# and busy/idle status, with a live capture-pane preview. Enter jumps there.

set -euo pipefail

# Unicode glob ranges below (braille spinner detection) require a UTF-8 locale.
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

sanity_check() {
    if ! command -v tmux &>/dev/null; then
        echo "tmux is not installed. Please install it first."
        exit 1
    fi

    if ! command -v fzf &>/dev/null; then
        echo "fzf is not installed. Please install it first."
        exit 1
    fi
}

sanity_check

# The `claude` binary is a symlink to a version-named executable
# (~/.local/share/claude/versions/2.1.222), so tmux's automatic-rename sets
# pane_current_command to something like "2.1.222", not "claude". Match on
# that shape rather than the literal name.
is_claude_cmd() {
    local cmd="$1"
    [[ "$cmd" == "claude" ]] && return 0
    [[ "$cmd" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && return 0
    return 1
}

declare -A SESSION_TITLE
declare -A SESSION_STATUS

# Reads ~/.claude/sessions/*.json (one per live Claude process, whose
# "name" field is the current chat name) to populate SESSION_TITLE/
# SESSION_STATUS keyed by the tmux pane's pid. Falls back silently (leaving
# the arrays empty) if jq isn't installed or no session files exist yet.
load_sessions() {
    command -v jq &>/dev/null || return 0

    local sessions_dir="$HOME/.claude/sessions"
    [[ -d "$sessions_dir" ]] || return 0

    # pid -> ppid, for walking a claude process's ancestors up to a pane's
    # own pid (claude may run directly in the pane, or under a shell).
    local -A ppid_of
    while read -r pid ppid; do
        ppid_of["$pid"]="$ppid"
    done < <(ps -eo pid=,ppid=)

    local -A pane_pids
    while read -r pid; do
        [[ -n "$pid" ]] && pane_pids["$pid"]=1
    done < <(tmux list-panes -a -F '#{pane_pid}')

    local f pid title claude_status
    for f in "$sessions_dir"/*.json; do
        [[ -e "$f" ]] || continue
        IFS=$'\t' read -r pid title claude_status < <(jq -r '[.pid, .name, .status] | @tsv' "$f" 2>/dev/null) || continue
        [[ -n "$pid" ]] || continue

        # Walk ancestors until we hit a live pane's pid.
        local walk="$pid"
        while [[ -n "$walk" && "$walk" != "0" && "$walk" != "1" ]]; do
            if [[ -n "${pane_pids[$walk]:-}" ]]; then
                [[ -n "$title" ]] && SESSION_TITLE["$walk"]="$title"
                [[ -n "$claude_status" ]] && SESSION_STATUS["$walk"]="$claude_status"
                break
            fi
            walk="${ppid_of[$walk]:-}"
        done
    done
}

# Nerd Font glyphs + truecolor ANSI, matching the fzf/tmux2k palette
# (busy green, idle dim gray, path in the same muted gray as the prompt).
ICON_BUSY=$''  # nf-fa-circle
ICON_IDLE=$''  # nf-fa-circle-thin
COLOR_BUSY=$'\033[38;2;143;191;143m'
COLOR_IDLE=$'\033[38;2;122;122;122m'
COLOR_DIR=$'\033[1;38;2;231;231;231m'
COLOR_TOPIC=$'\033[38;2;122;122;122m'
COLOR_PATH=$'\033[38;2;122;122;122m'
COLOR_RESET=$'\033[0m'

enumerate() {
    load_sessions

    local current_pane="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}' 2>/dev/null)}"
    local focused_row=""

    while IFS=$'\t' read -r pane_id cmd target path title pane_pid; do
        is_claude_cmd "$cmd" || continue

        # Claude prefixes the pane title with a braille spinner glyph
        # (U+2800-U+28FF) while it's actively working. Prefer the session
        # file's status when we have one for this pane.
        if [[ -n "${SESSION_STATUS[$pane_pid]:-}" ]]; then
            if [[ "${SESSION_STATUS[$pane_pid]}" == "busy" ]]; then
                icon="${COLOR_BUSY}${ICON_BUSY}${COLOR_RESET}"
            else
                icon="${COLOR_IDLE}${ICON_IDLE}${COLOR_RESET}"
            fi
        elif [[ "$title" == [⠀-⣿]* ]]; then
            icon="${COLOR_BUSY}${ICON_BUSY}${COLOR_RESET}"
        else
            icon="${COLOR_IDLE}${ICON_IDLE}${COLOR_RESET}"
        fi

        topic="$title"
        if [[ "$title" == [⠀-⣿]* ]]; then
            topic="${title#? }"
        fi

        display_path="${path/#$HOME/\~}"
        dir="$(basename "$path")"

        # Prefer the real chat name from Claude's own session/history files.
        if [[ -n "${SESSION_TITLE[$pane_pid]:-}" ]]; then
            topic="${SESSION_TITLE[$pane_pid]}"
        elif [[ "$topic" == "$(hostname -s)" ]]; then
            # Claude hasn't set a topic yet; title is still just the hostname.
            topic=""
        fi

        # Sink the pane this popup was launched from to the end of the list —
        # it's the one spot we already know, so it's the least useful to jump to.
        current_mark=""
        [[ "$pane_id" == "$current_pane" ]] && current_mark="  ${COLOR_PATH}· current${COLOR_RESET}"

        row=$(printf '%s\t%s  %s%-20s%s  %s%-34s%s  %s%s%s%s\n' \
            "$pane_id" "$icon" "$COLOR_DIR" "$dir" "$COLOR_RESET" "$COLOR_TOPIC" "$topic" "$COLOR_RESET" "$COLOR_PATH" "$display_path" "$COLOR_RESET" "$current_mark")

        if [[ "$pane_id" == "$current_pane" ]]; then
            focused_row="$row"
        else
            printf '%s' "$row"
        fi
    done < <(tmux list-panes -a -F '#{pane_id}	#{pane_current_command}	#{session_name}:#{window_index}.#{pane_index}	#{pane_current_path}	#{pane_title}	#{pane_pid}')

    [[ -n "$focused_row" ]] && printf '%s' "$focused_row"
}

if [[ "${1:-}" == "--enumerate" ]]; then
    enumerate
    exit 0
fi

self="$0"

header=$(printf '%s%s%s busy    %s%s%s idle    %s· current%s at bottom    ↵ jump    ^r refresh' \
    "$COLOR_BUSY" "$ICON_BUSY" "$COLOR_RESET" "$COLOR_IDLE" "$ICON_IDLE" "$COLOR_RESET" "$COLOR_PATH" "$COLOR_RESET")

selection=$(enumerate | fzf \
    --ansi \
    --no-separator \
    --delimiter '\t' \
    --with-nth 2.. \
    --preview "tmux capture-pane -e -p -t {1} -S -200 | tail -n \"\$FZF_PREVIEW_LINES\"" \
    --preview-window 'up:70%:wrap:border-bottom' \
    --preview-label ' pane output ' \
    --border none \
    --bind "ctrl-r:reload($self --enumerate)" \
    --header "$header" \
    || true)

if [[ -z "$selection" ]]; then
    exit 0
fi

pane_id="${selection%%$'\t'*}"

if ! tmux list-panes -a -F '#{pane_id}' | grep -qFx "$pane_id"; then
    tmux display-message "No Claude Code panes running"
    exit 0
fi

session=$(tmux display-message -p -t "$pane_id" '#{session_name}')

if [[ -z ${TMUX:-} ]]; then
    tmux attach-session -t "$session"
else
    tmux switch-client -t "$session"
fi

tmux select-window -t "$pane_id"
tmux select-pane -t "$pane_id"
